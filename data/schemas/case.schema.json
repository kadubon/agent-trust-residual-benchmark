{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/atrb/case.schema.json",
  "title": "ATRB benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "title", "category", "scenario", "user_task", "agent_output",
    "evidence_packet", "human_override", "expected_failures", "expected_decision",
    "expected_residuals", "expected_reusable"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "user_task": {"type": "string", "minLength": 1},
    "agent_output": {"type": "string", "minLength": 1},
    "evidence_packet": {
      "type": "object",
      "required": ["agent_id", "authority_scope", "requested_action", "nonce", "issued_at", "expires_at", "provenance"],
      "properties": {
        "agent_id": {"type": ["string", "null"]},
        "authority_scope": {"type": "array", "items": {"type": "string"}},
        "requested_action": {"type": "string"},
        "nonce": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "provenance": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "human_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["none", "approved", "rejected", "cancelled"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "expected_failures": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "expected_decision": {"enum": ["accept", "reject"]},
    "expected_residuals": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "expected_reusable": {"type": "boolean"}
  }
}
